{
  "manifest_version": 3,
  "name": "Arena DK Bets",
  "version": "1.2.0",
  "description": "Sends your DraftKings bets, balance and login to the Arena board.",
  "host_permissions": [
    "https://*.draftkings.com/*",
    "https://the-arenasports.pages.dev/*"
  ],
  "permissions": [
    "activeTab",
    "alarms",
    "cookies",
    "scripting",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.draftkings.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Send my bets to the Arena"
  },
  "background": {
    "service_worker": "background.js"
  }
}