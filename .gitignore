# fetched pages and boards, re-readable at any time
cache/
# what wrangler ships, built from master.html by pagefile.deployable()
site/index.html
# the settled games are large and rebuildable from ESPN
# the settled games travel with the repo: a deploy replaces the whole
# site folder, so leaving them behind would wipe them off the board
# site/final/
node_modules/
.DS_Store

# Screenshots taken while working, and the two logs the agent writes.
shots/
*.log
results.csv
# six gigabytes, copied from qbspy on Sep 18, 2026; not for the record
data/qbspy.db
data/qbspy.db-*

# compiled python, written by every run
__pycache__/
*.pyc

# the build stamp is written fresh by pagefile.deployable() on every run.
# Tracked, it was the one file both a sweep and a phone edit always rewrote,
# so every promote hit a conflict on it and mailed him about it.
site/build.txt

# wrangler pages dev scratch; never deployed, never committed
site/.wrangler/
